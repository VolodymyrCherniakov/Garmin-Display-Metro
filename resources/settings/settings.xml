<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <setting propertyKey="@Properties.SunlightMode" title="@Strings.SunlightModeTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.SunlightAuto</listEntry>
            <listEntry value="1">@Strings.SunlightLit</listEntry>
            <listEntry value="2">@Strings.SunlightDark</listEntry>
